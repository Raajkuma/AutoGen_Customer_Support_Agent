# --- Local LLM: Docker Model Runner (enable host TCP on 12434; `docker model pull ai/qwen3-vl:2B-BF16`) ---
LLM_BASE_URL=http://localhost:12434/engines/v1
LLM_MODEL=ai/qwen3-vl:2B-BF16
LLM_API_KEY=docker
# Inside a container use: http://model-runner.docker.internal/engines/v1
LLM_TIMEOUT=180
LLM_MAX_TOKENS=600

# --- Retrieval (embeddings are served by the same runner; verify the tag with `docker model list`) ---
EMBED_ENABLED=true
EMBED_MODEL=ai/qwen3-embedding
CHUNK_SIZE=120
CHUNK_OVERLAP=20
RETRIEVAL_K=6
RERANK_TOP_N=3
RRF_K=60
DENSE_MIN=0.55

# --- Staff access (required for Approvals and Workflow trace). Use a long random value. ---
STAFF_PIN=Eagle-Desk-7391-TN
